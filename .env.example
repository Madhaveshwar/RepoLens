# ============================================================
#  RepoLens AI – Environment Variables Template
#  Copy this file to .env and fill in real values before
#  running docker compose up --build  (or the dev server).
#
#  Variables marked [REQUIRED] will cause a hard startup
#  failure if missing.  Variables marked [OPTIONAL] use safe
#  defaults or are simply disabled when absent.
# ============================================================


# ──────────────────────────────────────────────────────────
#  SECURITY  [REQUIRED]
# ──────────────────────────────────────────────────────────

# Signs and verifies all JWT access tokens.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_generate_with_python_secrets_token_urlsafe_32

# AES-256 Fernet key used to encrypt every user's stored API keys at rest.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_with_Fernet_generate_key


# ──────────────────────────────────────────────────────────
#  DATABASE  [REQUIRED]
# ──────────────────────────────────────────────────────────

# Async connection string used by FastAPI (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://reviewer_user:reviewer_password@postgres:5432/code_reviewer

# Synchronous connection string used by Alembic migrations and Celery.
SYNC_DATABASE_URL=postgresql://reviewer_user:reviewer_password@postgres:5432/code_reviewer


# ──────────────────────────────────────────────────────────
#  REDIS / CELERY  [REQUIRED]
# ──────────────────────────────────────────────────────────

# Used as the Celery message broker and result backend.
# Also powers WebSocket real-time progress pub/sub.
REDIS_URL=redis://redis:6379/0


# ──────────────────────────────────────────────────────────
#  GITHUB INTEGRATION  [REQUIRED for scanning]
# ──────────────────────────────────────────────────────────

# Server-level fallback PAT.  Per-user PATs always take precedence.
# Scopes required: repo, read:user
GITHUB_TOKEN=ghp_CHANGE_ME_your_github_personal_access_token


# ──────────────────────────────────────────────────────────
#  AI / LLM PROVIDER KEYS  [At least one required to scan]
#
#  Per-user keys entered in the Settings page always take
#  priority.  These serve as server-level fallbacks.
# ──────────────────────────────────────────────────────────

# Groq – default provider; free tier available at console.groq.com
GROQ_API_KEY=gsk_CHANGE_ME_your_groq_api_key

# OpenAI – optional fallback; platform.openai.com
OPENAI_API_KEY=sk-CHANGE_ME_your_openai_api_key

# Anthropic Claude – optional; console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME_your_anthropic_key

# Google Gemini – optional; aistudio.google.com
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key

# OpenRouter – optional gateway to many models; openrouter.ai
OPENROUTER_API_KEY=sk-or-CHANGE_ME_your_openrouter_key


# ──────────────────────────────────────────────────────────
#  CORS  [OPTIONAL – adjust for your deployment]
# ──────────────────────────────────────────────────────────

BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000


# ──────────────────────────────────────────────────────────
#  GITHUB APP  [OPTIONAL – for webhook integration]
# ──────────────────────────────────────────────────────────

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=


# ──────────────────────────────────────────────────────────
#  LANGSMITH TRACING  [OPTIONAL]
# ──────────────────────────────────────────────────────────

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Automated_Code_Reviewer


# ──────────────────────────────────────────────────────────
#  DEVELOPER FLAGS  [OPTIONAL]
# ──────────────────────────────────────────────────────────

# Set to true to bypass the file-hash cache and force fresh LLM analysis.
FORCE_GROQ_ANALYSIS=false

# Set to true when running the automated test suite (skips startup validation).
TESTING=false


# ──────────────────────────────────────────────────────────
#  PASSWORD RESET / EMAIL  [OPTIONAL]
# ──────────────────────────────────────────────────────────

# "development" (default) or "production". In development, when SMTP is not
# configured, password-reset links are returned in the API response and shown
# in the UI so the flow works locally. NEVER set to development in production.
ENVIRONMENT=development

# Frontend base URL used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# How long a password-reset token stays valid (minutes).
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP settings. When SMTP_HOST and SMTP_FROM are set, reset links are emailed
# instead of shown in the UI. Leave empty for the local development flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true