# ============================================================
#  RepoLens AI – PRODUCTION Environment Variables
#  For deployment to Render (backend) + Vercel (frontend) +
#  managed PostgreSQL + Redis Cloud.
#
#  DO NOT commit this file with real values.
#  Use your hosting provider's secrets dashboard instead.
# ============================================================


# ──────────────────────────────────────────────────────────
#  SECURITY  [REQUIRED]
# ──────────────────────────────────────────────────────────

# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_production_jwt_secret_min_32_chars

# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_production_fernet_key_base64_44_chars


# ──────────────────────────────────────────────────────────
#  DATABASE (PostgreSQL)  [REQUIRED]
# ──────────────────────────────────────────────────────────
#
#  Render Postgres:  Dashboard → Database → Connection Strings
#  Supabase:         Project Settings → Database → URI
#  Railway:          Project → Variables → DATABASE_URL
#
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
SYNC_DATABASE_URL=postgresql://user:password@host:5432/dbname


# ──────────────────────────────────────────────────────────
#  REDIS  [REQUIRED]
# ──────────────────────────────────────────────────────────
#
#  Redis Cloud:   Create free database → copy "Redis URL"
#  Upstash:       Console → Details → Redis URL
#
REDIS_URL=redis://default:password@host:port/0


# ──────────────────────────────────────────────────────────
#  CORS  [REQUIRED in production]
# ──────────────────────────────────────────────────────────
#  Replace with your actual Vercel frontend URL.
BACKEND_CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com


# ──────────────────────────────────────────────────────────
#  GITHUB  [REQUIRED for scanning]
# ──────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_production_github_pat


# ──────────────────────────────────────────────────────────
#  LLM PROVIDERS  [At least one required]
# ──────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_production_groq_key
OPENAI_API_KEY=sk-your_production_openai_key
ANTHROPIC_API_KEY=sk-ant-your_production_anthropic_key
GEMINI_API_KEY=your_production_gemini_key
OPENROUTER_API_KEY=sk-or-your_production_openrouter_key


# ──────────────────────────────────────────────────────────
#  GITHUB APP (Webhook)  [OPTIONAL]
# ──────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=


# ──────────────────────────────────────────────────────────
#  LANGSMITH  [OPTIONAL]
# ──────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Automated_Code_Reviewer


# ──────────────────────────────────────────────────────────
#  FLAGS
# ──────────────────────────────────────────────────────────
FORCE_GROQ_ANALYSIS=false
TESTING=false
